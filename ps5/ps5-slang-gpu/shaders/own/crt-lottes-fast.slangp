# SPDX-License-Identifier: MIT
# ps5-slang-gpu: the library's own descriptor for crt-lottes-fast, built in. It names the pass from
# libretro's slang-shaders (crt/shaders/crt-lottes-fast.slang, Unlicense) and sets it as that collection runs it; README.md (Shaders).
shaders = 1
shader0 = ../slang/crt/shaders/crt-lottes-fast.slang
filter_linear0 = true
scale_type0 = viewport
