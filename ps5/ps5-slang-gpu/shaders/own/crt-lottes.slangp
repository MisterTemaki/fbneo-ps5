# SPDX-License-Identifier: MIT
# ps5-slang-gpu: the library's own descriptor for crt-lottes, built in. It names the pass from
# libretro's slang-shaders (crt/shaders/crt-lottes.slang, public domain) and sets it as that collection runs it; README.md (Shaders).
shaders = 1
shader0 = ../slang/crt/shaders/crt-lottes.slang
filter_linear0 = false
scale_type0 = viewport
