# SPDX-License-Identifier: MIT
# ps5-slang-gpu: the library's own descriptor for monoCRT, built in. It names the pass from
# libretro's slang-shaders (crt/shaders/monoCRT.slang, public domain) and sets it as that collection runs it; README.md (Shaders).
shaders = 1
shader0 = ../slang/crt/shaders/monoCRT.slang
scale_type0 = viewport
scale0 = 1.0
